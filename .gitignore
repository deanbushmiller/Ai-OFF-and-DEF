# Ai-OFF-and-DEF / SecLLM bootcamp
# Merged: the repo's original entries plus everything the containerised labs produce.

# --- macOS / editor noise ---
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
*~
*.swp
.idea/
.vscode/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/

# --- Student output (kept from the repo's original .gitignore) ---
evidence/
reports/

# --- Generated BY the labs at run time ---
# Created inside the container under /labs/labN/. They reach the host only if a
# lab is run with a bind mount instead of --rm. Student output, never source.
index.npz
answers.json
*-results.txt
lab*-results.txt
poisoned_handbook.pdf
bert_tiny_clean.pt
bert_tiny_poisoned.pt
data.pkl
unzipped/

# --- Models and asset caches ---
# Assets are baked at docker build time into /opt/lab-assets inside the image.
# Nothing model-shaped belongs in git.
*.safetensors
*.onnx
*.gguf
*.bin
!**/corpus/*.bin
lab-assets/
hf_cache/
.cache/huggingface/

# --- Container artefacts ---
*.tar
*.tar.gz

# --- Credentials - never, under any circumstances ---
.env
.env.*
*.pem
*.key
*_token
*.credentials

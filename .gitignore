# Ai-OFF-and-DEF / SecLLM bootcamp
# Merged: the repo's original entries plus everything the containerised labs produce.

# --- macOS / editor noise ---
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
*~
*.swp
.idea/
.vscode/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.venv/
venv/

# --- Student output (kept from the repo's original .gitignore) ---
evidence/
reports/

# --- Generated BY the labs at run time ---
# Created inside the container under /labs/labN/. They reach the host only if a
# lab is run with a bind mount instead of --rm. Student output, never source.
index.npz
answers.json
*-results.txt
lab*-results.txt
poisoned_handbook.pdf
bert_tiny_clean.pt
bert_tiny_poisoned.pt
data.pkl
unzipped/

# --- Models and asset caches ---
# Assets are baked at docker build time into /opt/lab-assets inside the image.
# Nothing model-shaped belongs in git.
*.safetensors
*.onnx
*.gguf
*.bin
!**/corpus/*.bin
lab-assets/
hf_cache/
.cache/huggingface/

# --- Container artefacts ---
*.tar
*.tar.gz

# --- Credentials - never, under any circumstances ---
.env
.env.*
*.pem
*.key
*_token
*.credentials

# Evidence the setup scripts copy OUT of the container and leave beside themselves:
# labN-results.txt, lab4-invoices/, atlas-layer.json, lab12-firewall-log.jsonl,
# lab13-policy.json, lab15-detector.json ... one or more per lab, and every new lab
# adds its own. These are a student's (or the instructor's) local test output and
# must never be committed. Ignore the whole directory by class rather than by name,
# then re-allow the only two files that belong there.
labs/*/setup/*
!labs/*/setup/setup.sh
!labs/*/setup/setup.ps1

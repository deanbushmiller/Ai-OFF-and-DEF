# Build context hygiene. Everything here is either irrelevant to the image or
# student output that would make builds non-reproducible.

# macOS / editor noise
.DS_Store
._*
Thumbs.db
*~
*.swp

# Python
__pycache__/
*.py[cod]

# Instructor-only - not shipped inside the student image
instructor/
INSTRUCTOR-TEST.md
publish.sh

# Host-side launcher scripts - students run these OUTSIDE the container
setup/

# Generated at BUILD time inside the image, or at run time by the student.
# Either way they must never come in from the build context.
#
# Written at RUN time by the lab: the firewall's request log and the runner's
# saved transcript. rules.json is NOT here - it is the shipped rule file the
# student tunes, and it must be in the image.
firewall-log.jsonl
*-results.txt

# Credentials
.env
*.pem
*.key
